{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "preserve",
    "checkJs": false,
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@views/*": ["./src/views/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["src/**/*", "app/**/*", "next-env.d.ts"],
  "exclude": ["node_modules", "dist", ".next"]
}
