{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "jsx": "preserve",
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "~/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@pages/*": ["./src/pages/*"]
    }
  },
  "include": ["src/**/*", "nuxt.config.ts"],
  "exclude": ["node_modules", "dist", ".nuxt", ".output"]
}
