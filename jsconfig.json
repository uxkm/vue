{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2015",
    "jsx": "preserve",
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@pages/*": ["./src/pages/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
