    {
      "label": "npm: lint:a11y",
      "type": "npm",
      "script": "lint:a11y",
      "detail": "JSX 접근성 전용 검사 · 진단이 있으면 실패",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "owner": "a11y",
          "fileLocation": [
            "relative",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": {
            "regexp": "^(.+):(\\d+):(\\d+) (\\S+) (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "code": 4,
            "message": 5
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
