{
  "name": "publish-list",
  "version": "3.0.0",
  "description": "Publish List — Next.js + React",
  "private": true,
  "scripts": {
    "dev": "npm run generate:registry && node scripts/serve.mjs --dev",
    "ui": "node scripts/ui.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "build": "npm run generate:registry && node scripts/build-styles.mjs && STYLE_MODE=css next build --webpack",
    "start": "node scripts/serve-static.mjs",
    "start:http": "npx --yes serve@14 out -l 8090",
    "lint": "next lint",
    "generate:registry": "node scripts/registry.mjs",
    "clean": "rm -rf .next out next-env.d.ts src/styles/css src/styles/dist node_modules/.cache .cache .turbo",
    "clean:modules": "rm -rf node_modules",
    "clean:all": "npm run clean && npm run clean:modules"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.11.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "ajv": "^8.17.1",
    "aos": "^2.3.4",
    "clipboard-copy": "^4.0.1",
    "dayjs": "^1.11.13",
    "filesize": "^10.1.6",
    "gsap": "^3.12.7",
    "hls.js": "^1.5.20",
    "js-base64": "^3.7.7",
    "lodash-es": "^4.17.21",
    "lottie-react": "^2.4.1",
    "lottie-web": "^5.12.2",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-youtube": "^10.1.0",
    "simplebar-react": "^3.3.0",
    "swiper": "^12.2.0",
    "viewerjs": "^1.11.7",
    "webstomp-client": "^1.2.6",
    "xss": "^1.0.15",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/aos": "^3.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.32",
    "raw-loader": "^4.0.2",
    "sass": "^1.83.0",
    "sass-embedded": "^1.108.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "minimatch": "^11.0.1"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "iOS >= 14",
    "Android >= 10"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
